# Skillet frontend — copy this file to `.env.local` (gitignored, and Next.js
# loads it automatically — `make dev` copies it for you on first run if it's
# missing). Every var below is optional; the default already points at the
# backend's own default local port.
#
# NEXT_PUBLIC_* vars are inlined by Next.js at *build* time, everywhere
# (server and client code alike) — not read at runtime. Changing this after
# `bun run build` requires rebuilding, not just restarting `bun run start`
# (discovered the hard way during `execution`'s own Task 6).

# Base URL of the FastAPI backend this frontend talks to.
# Default when absent: http://localhost:8000
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
